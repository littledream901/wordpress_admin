# 浏览器自动化 Agent 配置示例
# 复制此文件为 .env 并根据实际情况修改

# ========== 后端连接配置 ==========
BROWSER_AGENT_SERVER_URL=http://127.0.0.1:9999/api/v1
BROWSER_AGENT_USERNAME=agent_user
BROWSER_AGENT_PASSWORD=your_password_here

# ========== Worker 配置 ==========
BROWSER_AGENT_WORKER_NAME=worker-01
BROWSER_AGENT_PROVIDER_ID=0
BROWSER_AGENT_PROVIDER_CODE=hubstudio
BROWSER_AGENT_POLL_INTERVAL=5
BROWSER_AGENT_HEARTBEAT_INTERVAL=30
BROWSER_AGENT_MAX_BACKOFF=300
BROWSER_AGENT_LOG_DIR=./logs/browser_agent

# ========== HubStudio Connector 配置 ==========
HUBSTUDIO_CONNECTOR_DIR=D:\Program Files\Hubstudio
HUBSTUDIO_EXE_NAME=hubstudio_connector.exe
HUBSTUDIO_HTTP_PORT=6873
HUBSTUDIO_BASE_URL=http://localhost:6873

# ========== HubStudio 密钥配置（可选，优先从 DB 读取）==========
# 如果 BROWSER_AGENT_PROVIDER_ID = 0，可以在此配置兜底密钥
# 如果 BROWSER_AGENT_PROVIDER_ID ≠ 0，必须在后台配置中心配置
HUBSTUDIO_APP_ID=
HUBSTUDIO_APP_SECRET=
HUBSTUDIO_GROUP_CODE=
HUBSTUDIO_KERNEL_VER=137

# ========== HubStudio 任务执行默认值 ==========
HUBSTUDIO_DEFAULT_PROXY_TYPE=不使用代理
HUBSTUDIO_DEFAULT_UI_LANGUAGE=en
HUBSTUDIO_ADMIN_SITE_NAME=
HUBSTUDIO_ADMIN_SITE_ALIAS=
HUBSTUDIO_ADMIN_ACCOUNT_NAME=
HUBSTUDIO_ADMIN_ACCOUNT_PASSWORD=
HUBSTUDIO_BUSINESS_GROUP_NAME=

# ========== 向后兼容（旧环境变量，优先级低）==========
# 如果使用新环境变量，可忽略以下配置
# HUB_AGENT_SERVER_URL=http://127.0.0.1:9999/api/v1
# HUB_AGENT_USERNAME=agent_user
# HUB_AGENT_PASSWORD=your_password_here
